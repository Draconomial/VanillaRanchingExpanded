<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- A regular opt-in trainable: specialTrainable only enforces race-specific
         specialTrainables lists while Odyssey is active. Instead, animal races
         opt in via <trainableTags><li>VRE_Herd</li></trainableTags>, which the
         base-game training tracker recognizes with or without Odyssey. -->
    <TrainableDef>
        <defName>VRE_Herd</defName>
        <label>herd</label>
        <description>Herd roaming animals back toward their pens, keeping livestock where they belong.</description>
        <listPriority>799</listPriority>
        <difficulty>200</difficulty>
        <steps>2</steps>
        <prerequisites>
            <li>Release</li>
        </prerequisites>
    </TrainableDef>
</Defs>
