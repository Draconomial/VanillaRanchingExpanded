<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Keep Herd in the common defs. RimWorld only uses specialTrainables to restrict
         training by species when Odyssey is active. A race can opt into Herd with
         trainableTags whether Odyssey is enabled or disabled. -->
    <TrainableDef>
        <defName>VRE_Herd</defName>
        <label>herd</label>
        <description>Herd roaming animals back toward their pens, keeping livestock where they belong.</description>
        <listPriority>799</listPriority>
        <difficulty>200</difficulty>
        <steps>2</steps>
        <prerequisites>
            <li>Release</li>
        </prerequisites>
    </TrainableDef>
</Defs>
